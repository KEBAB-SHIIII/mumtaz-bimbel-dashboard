{
  "name": "mumtaz-bimbel",
  "private": true,
  "type": "module",
  "description": "Sistem pencatatan sesi les dan progres belajar Bimbel Mumtaz Sampit",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
