NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# 1. Neon Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.neon.tech/neondb?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST.region.neon.tech/neondb?sslmode=verify-full

# 2. Local Auth & Security
SESSION_SECRET=replace_with_random_secret_string
PARENT_ACCESS_CODE_PEPPER=replace_with_different_random_secret_string
BOOTSTRAP_ADMIN_USERNAME=admin.demo
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_password
# Default teknis development, bukan kebijakan bisnis final
SESSION_IDLE_TIMEOUT_MINUTES=480
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Dev-only: password awal tutor demo untuk seed sintetis; jangan dipakai di production
SEED_TUTOR_PASSWORD=replace_with_local_dev_password

# 3. Google Sheets Export (Bulanan)
GOOGLE_SHEETS_EXPORT_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json

# 4. Gemini AI Anomaly Screening
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
# Heuristik demo untuk finding duration_outlier (bukan aturan UMKM; lihat O-03/O-12)
ANOMALY_DURATION_OUTLIER_MINUTES=180

