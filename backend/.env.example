# Satu-satunya file env aplikasi (salin ke backend/.env; jangan commit nilai asli).
# Aplikasi selalu berjalan dalam mode production — di laptop maupun server.
# Backend menolak start bila: origin publik bukan HTTPS (localhost boleh HTTP), DB tanpa TLS,
# secret < 32 karakter/placeholder, password Admin < 12 karakter, atau SEED_TUTOR_PASSWORD diset.
NODE_ENV=production
PORT=3001
API_PREFIX=/api/v1
# Origin aplikasi. Laptop: http://localhost:3001 · server: https://domain-anda
FRONTEND_ORIGIN=http://localhost:3001
# Jumlah reverse proxy tepercaya (0 di laptop; 1 di balik proxy/load balancer server)
TRUST_PROXY=0
# Build frontend yang disajikan API dari origin yang sama (`npm run build`). Docker: /app/frontend/dist
FRONTEND_DIST_DIR=../frontend/dist

# 1. Neon (satu database). Pooled untuk app, direct untuk migration.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.neon.tech/neondb?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST.region.neon.tech/neondb?sslmode=verify-full

# 2. Auth & keamanan — hasilkan masing-masing: openssl rand -base64 48 (dua nilai BERBEDA).
# Jangan mengganti PARENT_ACCESS_CODE_PEPPER setelah dipakai: semua ID Akses Orang Tua jadi tidak valid.
SESSION_SECRET=replace_with_openssl_rand_base64_48
PARENT_ACCESS_CODE_PEPPER=replace_with_another_openssl_rand_base64_48
# Admin awal (`npm run start:bootstrap-admin -w backend`, idempoten)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_password_min_12
SESSION_IDLE_TIMEOUT_MINUTES=480
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Tarif honor tunggal per sesi (rupiah; D-24). Dikunci ke sesi saat disetujui, jadi bulan lalu tidak berubah.
HONOR_RATE_PER_SESSION=50000
# Batas atas durasi sesi (menit) saat submit/revisi; 1440 = batas teknis (bukan aturan UMKM — O-12)
ATTENDANCE_MAX_DURATION_MINUTES=1440

# 3. Google Sheets (ekspor bulanan oleh Admin). Service account diberi akses Editor ke spreadsheet.
GOOGLE_SHEETS_EXPORT_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json
GOOGLE_SHEETS_TIMEOUT_MS=20000

# 4. Gemini (screening anomali). Kosong = tidak aktif (status not_evaluated); absensi tetap tersimpan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Ambang finding duration_outlier (heuristik, bukan aturan UMKM; O-03/O-12)
ANOMALY_DURATION_OUTLIER_MINUTES=180
ANOMALY_PROVIDER_TIMEOUT_MS=20000
